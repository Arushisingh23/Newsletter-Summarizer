# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# RESEND_API_KEY: Optional free key from resend.com for automated Monday email delivery (up to 3,000 free emails/month)
RESEND_API_KEY="MY_RESEND_API_KEY"

# CRON_SECRET: Secret token for securing scheduled automated runs on Vercel or Cloud Scheduler
CRON_SECRET="MY_CRON_SECRET"

# Optional Firebase config overrides (configured in firebase-applet-config.json by default)
VITE_FIREBASE_API_KEY="AIzaSy..."
VITE_FIREBASE_AUTH_DOMAIN="newsletter-d8539.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="newsletter-d8539"
VITE_FIREBASE_APP_ID="1:..."

