rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Test connection doc
    match /test/{docId} {
      allow read: if true;
    }

    // User Profile
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && incoming().userId == request.auth.uid;
      allow update: if isOwner(userId) && incoming().userId == request.auth.uid;
      allow delete: if isOwner(userId);

      // User Preferences Subcollection
      match /preferences/{prefId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && incoming().userId == request.auth.uid;
        allow update: if isOwner(userId) && incoming().userId == request.auth.uid;
        allow delete: if isOwner(userId);
      }

      // User Experiments Subcollection
      match /experiments/{experimentId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && incoming().userId == request.auth.uid;
        allow update: if isOwner(userId) && incoming().userId == request.auth.uid;
        allow delete: if isOwner(userId);
      }

      // User Private Newsletter Summaries Subcollection
      match /summaries/{summaryId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && incoming().userId == request.auth.uid;
        allow update: if isOwner(userId) && incoming().userId == request.auth.uid;
        allow delete: if isOwner(userId);
      }
    }
  }
}
